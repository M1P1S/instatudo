# Arquivo de exemplo. Copie para .env e preencha se necessário.
# O sistema armazena a sessão do Instagram localmente em backend/db/session.json
# Nenhuma credencial precisa estar aqui – o login é feito pela interface web.

# Porta do servidor (padrão: 8000)
PORT=8000

# Host (padrão: 0.0.0.0)
HOST=0.0.0.0
