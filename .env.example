# Arquivo de exemplo. Copie para .env e preencha.

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── JWT (autenticação do app) ─────────────────────────────────────────────────
# IMPORTANTE: Troque por uma string longa e aleatória em produção!
JWT_SECRET=troque-por-uma-chave-secreta-longa-e-aleatoria

# ── Asaas (pagamentos) ────────────────────────────────────────────────────────
# Obtenha sua chave em: https://www.asaas.com/
ASAAS_API_KEY=sua_chave_asaas_aqui

# sandbox = ambiente de testes | production = ambiente real
ASAAS_ENVIRONMENT=sandbox

# ── Webhook Asaas ─────────────────────────────────────────────────────────────
# Configure no painel Asaas → Configurações → Notificações → Webhook
# URL: https://seu-dominio.com/api/webhooks/asaas
